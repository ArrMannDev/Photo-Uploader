      <a href="/folder/create/<%= folderId ? folderId : "" %>" class="flex flex-row items-center border-2 border-[#ffffff] hover:bg-[#F898D8] rounded-2xl px-3 py-3 gap-3 <%= folderId ? "hidden" : "flex" %> ">
