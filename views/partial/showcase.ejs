<div class="w-full flex flex-col justify-center gap-10 p-7">
  <h1 class="text-3xl text-[#da0e93] text-center">Files and Pics</h1>

  <div class="w-full flex flex-row flex-wrap justify-start items-center gap-15 py-5 px-10">
    <% folders.forEach((folder) => { %>
    <a href="/folder/<%= folder.folderid %>" class="flex flex-col justify-center items-center">
      <img src="../img/Folder-border.svg" alt="folder-img" />
      <span class="text-sm"><%= folder.foldername %></span>
    </a>
    <% }) %>

    <% images.forEach(image => { %>
      <div class="flex flex-col justify-center items-center gap-2">
        <img src="../uploads/<%= image.imageURL %>" alt="image" class="w-[100px] h-[105px]">
        <span class="text-sm"><%= image.image_name %></span>
      </div>
    <% }) %>
  </div>

</div>
