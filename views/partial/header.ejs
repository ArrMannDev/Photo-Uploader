<header class="flex flex-row justify-between items-center px-3">
    <img src="../img/logo.svg" alt="logo" class="rounded-2xl">
    <div class="flex flex-row items-center gap-4">
        <div class="flex flex-row items-center border-2 border-[#F898D8] rounded-2xl px-3 py-2 shadow-xl gap-2">
            <h1 class="hidden md:block xl:block">Create Folder</h1>
            <img src="../img/folder.svg" alt="folder">
        </div>
        
        <div class="flex flex-row items-center border-2 border-[#F898D8] rounded-2xl px-3 py-2 shadow-xl gap-2">
            <h1 class="hidden md:block xl:block">Upload Picture</h1>
            <img src="../img/folder.svg" alt="folder">
        </div>

        <a href="/auth/login" class="flex flex-row items-center border-2 border-[#F898D8] rounded-2xl px-3 py-2 shadow-xl gap-2">
            <h1 class="hidden md:block xl:block"><%= user ? user.name: "Sign In" %></h1>
            <img src="../img/Sign_in_circle.svg" alt="Login">
        </a>
    </div>
</header>