<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/src/output.css" rel="stylesheet">
    <title><%= title %></title>
</head>
<body class="inset-0 w-fit mx-auto transform translate-y-1/2">
    <!-- <h1><%# message %></h1> -->

    <form action="/folder/create"  method="post" class="w-[400px] h-[300px] flex flex-col items-center gap-4 border-1 border-[#F898D8] rounded-2xl px-3 py-2 shadow-xl">
        <h1 class="text-4xl text-[#da0e93] my-3"><%= title %></h1>

        <div class="flex flex-col gap-2 items-start justify-center">
            <label for="foldername" class="block text-sm">Folder Name </label>
            <input type="text" id="foldername" name="foldername" placeholder="Folder Name" class="w-[300px] border-1 border-[#F898D8] px-3 py-2 outline-none rounded-2xl">
        </div>

        <div class="flex-col gap-2 items-start justify-center hidden">
            <label for="userID" class="block text-sm">User ID </label>
            <input type="text" id="userID" name="userID" value="<%= user ? user.id : "" %>" placeholder="User ID" class="w-[300px] border-1 border-[#F898D8] px-3 py-2 outline-none rounded-2xl">
        </div>

        <div class="flex  w-[300px] mt-5 rounded-2xl hover:bg-[#F898D8] hover:cursor-pointer">
            <button type="submit" class="border-2 border-[#F898D8] rounded-2xl px-3 py-2 shadow-xl text-sm w-full">Log In</button>
        </div>
    </form>
   
</body>
</html>