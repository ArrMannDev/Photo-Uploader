<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/src/output.css" rel="stylesheet">
    <title>Sign Up</title>
</head>
<body class="inset-0 w-fit mx-auto transform translate-y-1/4">
    <form action="/auth/signUp" method="post" class="w-[400px] h-auto flex flex-col items-center gap-4 border-1 border-[#F898D8] rounded-2xl px-3 py-2 shadow-xl" enctype="multipart/form-data">
        <h1 class="text-4xl text-[#da0e93] my-3"><%= title %></h1>

        <div class="flex flex-col gap-2 items-start justify-center">
            <label for="username" class="block text-sm">User Name </label>
            <input type="text" name="username" placeholder="username" class="w-[300px] border-1 border-[#F898D8] px-3 py-2 outline-none rounded-2xl">
        </div>

        <div class="flex flex-col gap-2 items-start justify-center">
            <label for="email" class="block text-sm">Email </label>
            <input type="text" name="email" placeholder="Email" class="w-[300px] border-1 border-[#F898D8] px-3 py-2 outline-none rounded-2xl">
        </div>

        <div class="flex flex-col gap-2 items-start justify-center">
            <label for="password" class="block text-sm">Password: </label>
            <input type="password" name="password" placeholder="Password" class="w-[300px] border-1 border-[#F898D8] px-3 py-2 outline-none rounded-2xl">
        </div>

        <div class="flex flex-col gap-2 items-start justify-center">
            <label for="photo" class="block text-sm">Profile Picture: </label>
            <input type="file" name="photo" placeholder="photo" class="w-[300px] border-1 border-[#F898D8] px-3 py-2 outline-none rounded-2xl">
        </div>

        <div class="flex  w-[300px] mt-4  mb-7 rounded-2xl hover:bg-[#F898D8] hover:cursor-pointer">
            <button type="submit" class="border-2 border-[#F898D8] rounded-2xl px-3 py-2 shadow-xl text-sm w-full">Register</button>
        </div>
    </form>
   
</body>
</html>