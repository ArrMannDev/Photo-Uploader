<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/src/output.css" rel="stylesheet" />
    <title>Details Page</title>
  </head>

  <body class="flex flex-col min-h-screen bg-gray-50 overflow-x-hidden">
    <!-- Header -->
    <%- include('partial/header') %>

    <!-- Main Content -->
    <div class="flex flex-row flex-grow h-screen">
      <!-- Sidebar -->
      <%- include('partial/sidebar') %>

      <!-- Image Grid -->
      <div class="w-full h-full flex flex-col gap-10 py-5 px-10">
        <div class="flex flex-row flex-wrap justify-start items-center gap-10">
          <% images.forEach(image => { %>
          <div
            class="flex flex-col justify-center items-center gap-2 bg-white shadow-md p-3 rounded-lg"
          >
            <img
              src="/folders/<%= folderName %>/<%= image.imageURL %>"
              alt="image"
              class="w-[100px] h-[115px] object-cover rounded"
            />
            <div class="flex flex-row items-center gap-2">
              <span class="text-sm font-medium"><%= image.image_name %></span>
              <form action="/image/delete" method="post" class="inline">
                <input
                  type="hidden"
                  name="imageid"
                  value="<%= image.imageid %>"
                />
                <button type="submit" class="flex items-center">
                  <img
                    src="../img/Remove_fill.svg"
                    alt="delete-image"
                    class="w-4 h-4"
                  />
                </button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <!-- Pagination -->
        <div class="text-center my-6">
          <% if (totalPages > 1) { %>

          <!-- Previous Button -->
          <% if (currentPage > 1) { %>
          <a
            href="/folder/<%= folderId %>?page=<%= currentPage - 1 %>"
            style="
              padding: 8px 12px;
              border: 1px solid #ddd;
              border-radius: 6px;
              color: #333;
              text-decoration: none;
              margin: 0 4px;
            "
          >
            Previous
          </a>
          <% } %>

          <!-- Page Numbers -->
          <% for (let i = 1; i <= totalPages; i++) { %> <% if (i ===
          currentPage) { %>
          <span
            style="
              padding: 8px 12px;
              border-radius: 6px;
              background: #f898d8;
              color: white;
              margin: 0 4px;
            "
          >
            <%= i %>
          </span>
          <% } else { %>
          <a
            href="/folder/<%= folderId %>?page=<%= i %>"
            style="
              padding: 8px 12px;
              border: 1px solid #ddd;
              border-radius: 6px;
              color: #333;
              text-decoration: none;
              margin: 0 4px;
            "
          >
            <%= i %>
          </a>
          <% } %> <% } %>

          <!-- Next Button -->
          <% if (currentPage < totalPages) { %>
          <a
            href="/folder/<%= folderId %>?page=<%= currentPage + 1 %>"
            style="
              padding: 8px 12px;
              border: 1px solid #ddd;
              border-radius: 6px;
              color: #333;
              text-decoration: none;
              margin: 0 4px;
            "
          >
            Next
          </a>
          <% } %> <% } %>
        </div>
      </div>
    </div>

    <script>
      const navBtn = document.getElementById("navBtn");
      const sidebar = document.getElementById("sidebar");

      if (navBtn && sidebar) {
        const navBtnImg = navBtn.querySelector("img");
        const h1Tags = sidebar.querySelectorAll("li h1");
        let clicked = false;

        navBtn.addEventListener("click", () => {
          if (clicked) {
            sidebar.style.width = "100px";
            h1Tags.forEach((h1) => {
              h1.classList.add("opacity-0");
              h1.classList.remove("opacity-100");
            });
            navBtn.style.left = "96px";
            navBtnImg.src = "/img/Expand_Right.svg";
            clicked = false;
          } else {
            sidebar.style.width = "340px";
            h1Tags.forEach((h1) => {
              h1.classList.remove("opacity-0");
              h1.classList.add("opacity-100");
            });
            navBtn.style.left = "282px";
            navBtnImg.src = "/img/Expand_left.svg";
            clicked = true;
          }
        });
      }
    </script>
  </body>
</html>
